# lnd or cln (REST); leave unset to run without a funding source. Also
# powers LUD-25's optional Offline verification (signed via the node's own
# signmessage RPC) - there's no separate setting for that.
FUNDINGSOURCE_BACKEND=cln
FUNDINGSOURCE_URL=https://localhost:3010
FUNDINGSOURCE_RUNE=<rune>
# FUNDINGSOURCE_CERT_PATH=/path/to/ca.pem

# alternative: lnd instead of cln
# FUNDINGSOURCE_BACKEND=lnd
# FUNDINGSOURCE_URL=https://localhost:8080
# FUNDINGSOURCE_MACAROON=<hex admin.macaroon>
# FUNDINGSOURCE_CERT_PATH=/path/to/tls.cert

# alternative: a spark wallet (https://github.com/breez/spark-sdk) instead
# of a Lightning node - no node, no channels, no liquidity management:
# the mint funds itself from a breez-sdk-spark wallet held in-process.
# Requires the optional dependency (`uv sync --extra spark`) and the
# storage dir rule below. The mnemonic is the wallet's entire key
# material - a hot wallet seed, treat accordingly.
# FUNDINGSOURCE_BACKEND=spark
# FUNDINGSOURCE_SPARK_MNEMONIC=<12/24 BIP39 words>
# FUNDINGSOURCE_SPARK_API_KEY=<breez api key>
# FUNDINGSOURCE_SPARK_NETWORK=mainnet
# FUNDINGSOURCE_SPARK_STORAGE_DIR=/var/lib/lnurl-mint/spark-wallet
# FUNDINGSOURCE_SPARK_SYNC_INTERVAL_SECS=15
# (the SDK keeps its own sqlite store there - like DATABASE_PATH, never
# share it between two processes; unset defaults to a spark-wallet/
# directory next to DATABASE_PATH)

# bounds on a single minted note, in msat
MIN_SENDABLE_MSAT=10000
MAX_SENDABLE_MSAT=1000000000

# LUD-25's optional mint fee: withheld from every minted note's value (a
# flat BASE_FEE_MSAT plus FEE_PERCENT_PPM parts-per-million of the amount
# paid), meant to cover the routing cost of eventually paying the note back
# out on melt. Advertised in /p/cb's payRequest metadata so a wallet can
# warn the payer up front - set both to 0 to run fee-free (the metadata
# entry is then omitted entirely, per spec).
BASE_FEE_MSAT=1000
FEE_PERCENT_PPM=0

# floor on a note's value net of the mint fee (not on the amount paid,
# which MIN_SENDABLE_MSAT already bounds) - guards against minting
# dust-value notes not worth the routing cost of ever melting them
MIN_MINT_MSAT=10000

# cap on the number of k1s a single /w/cb request (melt/rotate/split/merge)
# may name - well above any real wallet's outstanding note count, just to
# bound the DB lookups a single unauthenticated request can force
MAX_K1S=100

# winds this mint down: /p/cb (minting) and /w/cb's split branch both start
# rejecting outright, since both grow the number of outstanding notes -
# rotate, merge, and melt still work, so holders can consolidate and redeem
# what they have. Off by default.
SUNSET_MINT=false

DATABASE_PATH=mint.db

# LUD-21 (optional): serve /verify/{payment_hash} and advertise a `verify`
# URL in the mint invoice's response, so a wallet with no node of its own
# can poll settlement status. Once settled, the response includes the spec's
# `preimage` field - for lnurlcash the preimage IS the bearer note's spend
# secret, so a wallet with no node of its own needs it to claim the note,
# and MUST rotate the note immediately after (this mint's own node is a
# permanent prior holder of it regardless). Beware: the payment hash travels
# inside the invoice itself, so anyone who sees an unpaid mint invoice can
# win that race against a slow (manual/custodial) claimant - see README's
# "The observer race, plainly". Unlike the usual LUD-21 convention, false
# here disables the endpoint entirely (404), not just its advertisement.
# On by default.
VERIFY_ENABLED=true

# LUD-25 Part 2 (optional): serve POST/DELETE /p/{username}, letting a
# WALLET claim a Lightning Address username against its own cx1 branch
# export - this mint then auto-mints a cp1 note for every payment it
# receives there, no per-payment WALLET involvement needed. Same off-switch
# convention as
# VERIFY_ENABLED (404 when off). This mint's own fixed identity (USERNAME/
# the bare-domain `_`) is unaffected either way. On by default.
USERNAME_REGISTRATION_ENABLED=true

# NIP-05 (optional): serve GET /.well-known/nostr.json and accept the
# optional `npub` argument to POST /p/{username}, so a registered username
# doubles as a Nostr identifier. Independent of
# USERNAME_REGISTRATION_ENABLED above - registration can stay on while this
# is off (npub rejected at registration, nostr.json 404s), or the reverse.
# Same off-switch convention as VERIFY_ENABLED (404 when off). On by default.
NIP05_ENABLED=true

# NIP-57 zaps (optional): this mint's own Nostr key, 32 bytes of hex. Set,
# a registered username can be zapped: the invoice is bound to the zap
# request and the kind 9735 receipt is published, signed with this key,
# once it settles. Publish-only; the mint subscribes to nothing. Needs an
# lnd or cln funding source. Unset, zaps are off.
# NOSTR_KEY=<32 bytes hex>
# relays every receipt goes to, on top of the ones the zap request names
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
# how often settled zap invoices are looked for; a client waits on the receipt
# ZAP_POLL_INTERVAL_SECONDS=5

# the one-pager frontend (GET /)
TITLE=lnurl-mint
DESCRIPTION=A minimal lnurlcash mint.
# public base URL of this mint - used for the QR code's LNURL and the
# lightning address domain. Required: this mint will not derive it from a
# request's own Host header (untrustworthy - can be spoofed by any caller,
# or by a cache poisoning attack if fronted by a Host-agnostic cache).
BASE_URL=https://mint.example
# this mint's Tor hidden service address, if it has one - shown on the
# frontend as an alternative way to reach it. When a wallet is actually
# connecting through it, it's used as the base for LNURL/callback URLs
# instead of BASE_URL above, so paying/withdrawing still works over Tor.
# ONION_URL=http://<v3-address>.onion
# the mint is payable at {USERNAME}@{BASE_URL host}
USERNAME=mint
